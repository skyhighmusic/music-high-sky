{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated platform user with RBAC role assignment and isolated account metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "enum": ["super_admin", "artist", "label_manager"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "emailNotifications": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "status", "createdAt", "updatedAt"]
    },
    "Artist": {
      "title": "Artist",
      "description": "Official artist profile managed under Music High Sky (Sunil Kumar).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "professions": { "type": "array", "description": "Up to 10 roles such as Musician, Singer, Lyricist, Independent Artist" },
        "genres": { "type": "array", "description": "Up to 15 genres" },
        "languages": { "type": "array", "description": "Up to 15 languages" },
        "label": { "type": "string", "maxLength": 120 },
        "primaryMarket": { "type": "string", "maxLength": 100 },
        "distributionScope": { "type": "string", "maxLength": 100 },
        "biography": { "type": "string", "maxLength": 4000 },
        "profilePhotoUrl": { "type": "string", "maxLength": 350000 },
        "spotifyUrl": { "type": "string", "maxLength": 500 },
        "youtubeUrl": { "type": "string", "maxLength": 500 },
        "instagramUrl": { "type": "string", "maxLength": 500 },
        "facebookUrl": { "type": "string", "maxLength": 500 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "professions", "genres", "languages", "label", "biography", "createdAt", "updatedAt"]
    },
    "Release": {
      "title": "Release",
      "description": "Master release document for either an Audio Song Release or Official Music Video.",
      "type": "object",
      "properties": {
        "releaseCode": { "type": "string", "minLength": 3, "maxLength": 40 },
        "releaseType": { "type": "string", "enum": ["audio", "video"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 200 },
        "primaryArtist": { "type": "string", "minLength": 1, "maxLength": 150 },
        "featuredArtist": { "type": "string", "maxLength": 200 },
        "singer": { "type": "string", "maxLength": 200 },
        "lyricist": { "type": "string", "maxLength": 200 },
        "composer": { "type": "string", "maxLength": 200 },
        "musicProducer": { "type": "string", "maxLength": 200 },
        "musicDirector": { "type": "string", "maxLength": 200 },
        "mixingEngineer": { "type": "string", "maxLength": 200 },
        "masteringEngineer": { "type": "string", "maxLength": 200 },
        "genre": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subgenre": { "type": "string", "maxLength": 100 },
        "language": { "type": "string", "minLength": 1, "maxLength": 100 },
        "mood": { "type": "string", "maxLength": 100 },
        "explicitContent": { "type": "boolean" },
        "originalReleaseDate": { "type": "string", "maxLength": 40 },
        "plannedReleaseDate": { "type": "string", "maxLength": 40 },
        "releaseTime": { "type": "string", "maxLength": 20 },
        "copyrightYear": { "type": "string", "maxLength": 10 },
        "copyrightOwner": { "type": "string", "maxLength": 200 },
        "phonographicCopyright": { "type": "string", "maxLength": 250 },
        "publishingCopyright": { "type": "string", "maxLength": 250 },
        "distributorLabel": { "type": "string", "maxLength": 120 },
        "artistCredit": { "type": "string", "maxLength": 150 },
        "labelCredit": { "type": "string", "maxLength": 150 },
        "creditNotes": { "type": "string", "maxLength": 500 },
        "targetPlatforms": { "type": "array", "description": "Up to 20 intended DSP names" },
        "status": {
          "type": "string",
          "enum": [
            "Draft",
            "Submitted",
            "Under Review",
            "Metadata Correction Required",
            "Approved",
            "Scheduled",
            "Processing",
            "Delivered",
            "Live",
            "Rejected",
            "Takedown Requested",
            "Taken Down",
            "Archived"
          ]
        },
        "reviewNotes": { "type": "string", "maxLength": 1000 },
        "artworkPreview": { "type": "string", "maxLength": 350000 },
        "smartLinkSlug": { "type": "string", "maxLength": 120 },
        "featured": { "type": "boolean" },
        "driveFileId": { "type": "string", "maxLength": 200 },
        "sourceOrigin": { "type": "string", "maxLength": 100 },
        "submittedBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "submittedByName": { "type": "string", "maxLength": 120 },
        "submissionDate": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "releaseCode",
        "releaseType",
        "title",
        "primaryArtist",
        "genre",
        "language",
        "distributorLabel",
        "artistCredit",
        "labelCredit",
        "status",
        "submittedBy",
        "submissionDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "AudioTrack": {
      "title": "AudioTrack",
      "description": "Validated audio master metadata and waveform peaks linked to an audio release.",
      "type": "object",
      "properties": {
        "releaseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "format": { "type": "string", "enum": ["WAV", "FLAC", "MP3"] },
        "fileSizeBytes": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "sampleRate": { "type": "number" },
        "channels": { "type": "number" },
        "waveformPeaks": { "type": "array", "description": "Up to 128 normalized peak floats" },
        "masterSourceUrl": { "type": "string", "maxLength": 1000 },
        "storagePath": { "type": "string", "maxLength": 600 },
        "driveFileId": { "type": "string", "maxLength": 200 },
        "validated": { "type": "boolean" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["releaseId", "fileName", "format", "fileSizeBytes", "validated", "ownerId", "createdAt", "updatedAt"]
    },
    "VideoRelease": {
      "title": "VideoRelease",
      "description": "Official music video production credits and validated video file metadata linked to a video release.",
      "type": "object",
      "properties": {
        "releaseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "director": { "type": "string", "maxLength": 200 },
        "producer": { "type": "string", "maxLength": 200 },
        "productionCompany": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 3000 },
        "fileName": { "type": "string", "maxLength": 260 },
        "format": { "type": "string", "enum": ["MP4", "MOV", "MKV", "WEBM", "EXTERNAL"] },
        "fileSizeBytes": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "resolution": { "type": "string", "maxLength": 40 },
        "youtubeUrl": { "type": "string", "maxLength": 500 },
        "videoCopyrightInfo": { "type": "string", "maxLength": 500 },
        "masterSourceUrl": { "type": "string", "maxLength": 1000 },
        "storagePath": { "type": "string", "maxLength": 600 },
        "driveFileId": { "type": "string", "maxLength": 200 },
        "thumbnailPreview": { "type": "string", "maxLength": 350000 },
        "validated": { "type": "boolean" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["releaseId", "format", "validated", "ownerId", "createdAt", "updatedAt"]
    },
    "Artwork": {
      "title": "Artwork",
      "description": "Cover artwork or video thumbnail asset metadata and compact preview.",
      "type": "object",
      "properties": {
        "releaseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "kind": { "type": "string", "enum": ["cover_art", "video_thumbnail", "promo_banner"] },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "format": { "type": "string", "enum": ["JPG", "JPEG", "PNG"] },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "aspectRatioValid": { "type": "boolean" },
        "previewDataUrl": { "type": "string", "maxLength": 350000 },
        "locked": { "type": "boolean" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["releaseId", "kind", "fileName", "format", "width", "height", "aspectRatioValid", "ownerId", "createdAt", "updatedAt"]
    },
    "DistributionRecord": {
      "title": "DistributionRecord",
      "description": "Transparent per-DSP partner submission and confirmed delivery record.",
      "type": "object",
      "properties": {
        "releaseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "releaseTitle": { "type": "string", "maxLength": 200 },
        "releaseType": { "type": "string", "enum": ["audio", "video"] },
        "platformId": { "type": "string", "maxLength": 80 },
        "platformName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "distributorLabel": { "type": "string", "maxLength": 120 },
        "partnerName": { "type": "string", "maxLength": 150 },
        "externalReferenceId": { "type": "string", "maxLength": 150 },
        "status": {
          "type": "string",
          "enum": [
            "Planned",
            "Submitted to Partner",
            "Processing",
            "Delivered",
            "Live",
            "Rejected",
            "Takedown Requested",
            "Taken Down"
          ]
        },
        "deliveryConfirmedDate": { "type": "string", "maxLength": 40 },
        "liveUrl": { "type": "string", "maxLength": 500 },
        "evidenceNotes": { "type": "string", "maxLength": 1000 },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["releaseId", "releaseTitle", "releaseType", "platformName", "distributorLabel", "status", "ownerId", "createdAt", "updatedAt"]
    },
    "Platform": {
      "title": "Platform",
      "description": "Supported audio and video DSP destination directory.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "enum": ["audio", "video", "both"] },
        "regionScope": { "type": "string", "maxLength": 80 },
        "serviceAvailabilityNote": { "type": "string", "maxLength": 300 },
        "enabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "enabled", "createdAt", "updatedAt"]
    },
    "RoyaltyRecord": {
      "title": "RoyaltyRecord",
      "description": "Verified royalty statement record imported from CSV or entered from an authorized distributor report.",
      "type": "object",
      "properties": {
        "period": { "type": "string", "minLength": 4, "maxLength": 20 },
        "releaseId": { "type": "string", "maxLength": 128 },
        "releaseTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "platformName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "territory": { "type": "string", "maxLength": 100 },
        "currency": { "type": "string", "enum": ["INR", "USD"] },
        "streams": { "type": "number" },
        "estimatedRoyalty": { "type": "number" },
        "confirmedRoyalty": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Estimated", "Confirmed", "Pending Payment", "Paid"] },
        "paymentReference": { "type": "string", "maxLength": 150 },
        "paidDate": { "type": "string", "maxLength": 40 },
        "sourceType": { "type": "string", "enum": ["CSV Import", "Manual Verified Entry"] },
        "sourceReportName": { "type": "string", "maxLength": 200 },
        "verifiedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["period", "releaseTitle", "platformName", "currency", "streams", "estimatedRoyalty", "confirmedRoyalty", "paymentStatus", "sourceType", "verifiedBy", "createdAt", "updatedAt"]
    },
    "AnalyticsRecord": {
      "title": "AnalyticsRecord",
      "description": "Verified streaming & geographic performance record from authorized DSP reports.",
      "type": "object",
      "properties": {
        "period": { "type": "string", "minLength": 4, "maxLength": 20 },
        "releaseId": { "type": "string", "maxLength": 128 },
        "releaseTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "platformName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "territory": { "type": "string", "minLength": 1, "maxLength": 100 },
        "streams": { "type": "number" },
        "sourceReportName": { "type": "string", "maxLength": 200 },
        "verifiedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["period", "releaseTitle", "platformName", "territory", "streams", "verifiedBy", "createdAt", "updatedAt"]
    },
    "CopyrightRecord": {
      "title": "CopyrightRecord",
      "description": "Administrator-verified copyright, ISRC, UPC/EAN, Content ID, licensing, and takedown record.",
      "type": "object",
      "properties": {
        "releaseId": { "type": "string", "maxLength": 128 },
        "releaseTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "songOwnership": { "type": "string", "maxLength": 250 },
        "masterRecordingRights": { "type": "string", "maxLength": 250 },
        "publishingRights": { "type": "string", "maxLength": 250 },
        "lyricsOwnership": { "type": "string", "maxLength": 250 },
        "compositionOwnership": { "type": "string", "maxLength": 250 },
        "registrationNumber": { "type": "string", "maxLength": 120 },
        "isrc": { "type": "string", "maxLength": 40 },
        "upcEan": { "type": "string", "maxLength": 40 },
        "contentIdStatus": { "type": "string", "enum": ["Not Enrolled", "Pending", "Active", "Disputed"] },
        "contentIdAssetId": { "type": "string", "maxLength": 120 },
        "licensingNotes": { "type": "string", "maxLength": 1000 },
        "distributionAgreementRef": { "type": "string", "maxLength": 200 },
        "takedownStatus": { "type": "string", "enum": ["None", "Requested", "In Progress", "Completed"] },
        "takedownNotes": { "type": "string", "maxLength": 500 },
        "verifiedByAdmin": { "type": "boolean" },
        "verifiedByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["releaseTitle", "contentIdStatus", "takedownStatus", "verifiedByAdmin", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app and email-flagged workflow notification.",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string", "maxLength": 128 },
        "recipientRole": { "type": "string", "enum": ["all", "super_admin", "artist", "label_manager"] },
        "category": {
          "type": "string",
          "enum": [
            "New Song Submission",
            "Submission Received",
            "Metadata Correction Required",
