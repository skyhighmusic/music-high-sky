        "brandingCount": { "type": "number" },
        "importedCount": { "type": "number" },
        "duplicateCount": { "type": "number" },
        "failedCount": { "type": "number" },
        "pendingVerificationCount": { "type": "number" },
        "logsJson": { "type": "string", "maxLength": 450000 },
        "triggeredBy": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "triggeredByName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
